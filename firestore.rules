rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to the "branches" collection
    match /branches/{branchId} {
      allow read: if true;  // Allow anyone to read branches
    }

    // Example: Restrict access to users collection to only authenticated users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
